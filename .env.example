# CodeTrain ローカル環境の設定（Document/LOCAL_DEV.md §5.3）
#
#   cp .env.example .env
#
# .env は Git 管理外。このファイル（.env.example）だけを Git で管理する。
#
# 注意: admin(Next.js) は compose 管理外のため、ここではなく
#       codetrain-admin/.env.local から設定を読む。

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_VERSION=16
POSTGRES_USER=codetrain
POSTGRES_PASSWORD=codetrain
POSTGRES_DB=codetrain
# ホスト側に公開するポート。既に別の PostgreSQL が 5432 を使っている場合は変更する
# （LOCAL_DEV.md §11「ポート衝突」）。コンテナ間の接続には影響しない。
POSTGRES_PORT=5432

# コンテナ間はサービス名で解決する。ホストから繋ぐときは
# postgres://codetrain:codetrain@localhost:${POSTGRES_PORT}/codetrain?sslmode=disable
DATABASE_URL=postgres://codetrain:codetrain@postgres:5432/codetrain?sslmode=disable

# --- api ---------------------------------------------------------------------
API_PORT=8080

# dev   : 署名検証をせず X-Dev-User ヘッダを sub として扱う（既定）
# cognito: JWKS を取得して本番と同じコードパスで検証する
# LOCAL_DEV.md §5.4
AUTH_MODE=dev

# AUTH_MODE=cognito のときだけ使う。値は scripts/bootstrap-ministack.sh が
# .generated/cognito.env に出力する（Ministack が Cognito に対応していれば）。
COGNITO_JWKS_URL=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# 開発時のみ緩める。admin のオリジン。
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AWS（Ministack） ---------------------------------------------------------
MINISTACK_VERSION=1.5
MINISTACK_PORT=4566
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=ap-northeast-1
# Ministack はダミー資格情報で通る
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
S3_BUCKET=codetrain-local

# --- Go ----------------------------------------------------------------------
# codetrain-core を private module として取得するときに使う。
# 現在は go.mod の replace で隣のチェックアウトを指しているため未使用。
GOPRIVATE=github.com/gabaison-2026-09/*

# --- tools -------------------------------------------------------------------
# adminer（DB 閲覧）は常時起動する。http://localhost:8081
ADMINER_PORT=8081

# Ministack の初期化（aws-init サービス）に使う AWS CLI のバージョン
AWS_CLI_VERSION=2.32.9
# Cognito のテストユーザーのパスワード（AUTH_MODE=cognito のときだけ使う）
COGNITO_TEST_PASSWORD=CodeTrain#Local1

# --- Track A（pipeline 着手時に使う） -----------------------------------------
# replay（既定・カセットから再生） / record / live — LOCAL_DEV.md §7.1
LLM_MODE=replay
# record / live のときだけ必要。replay では空でよい（課金が発生しない）
ANTHROPIC_API_KEY=
# 収集時のみ必要
GITHUB_TOKEN=
